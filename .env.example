const express = require('express');
const cors = require('cors');
const path = require('path');
const fs = require('fs');
const crypto = require('crypto');
const bcrypt = require('bcryptjs');
const jwt = require('jsonwebtoken');
const multer = require('multer');
const sqlite3 = require('sqlite3').verbose();
require('dotenv').config();

const app = express();
const PORT = Number(process.env.PORT || 3000);
const JWT_SECRET = process.env.JWT_SECRET || 'change_this_secret_in_production';
const ENCRYPTION_KEY = process.env.ENCRYPTION_KEY || 'billflow-dev-encryption-key-change-me';
const DATA_DIR = path.join(__dirname, 'data');
const DB_PATH = path.join(DATA_DIR, 'billflow.db');
const UPLOAD_DIR = path.join(__dirname, 'uploads');

fs.mkdirSync(DATA_DIR, { recursive: true });
fs.mkdirSync(UPLOAD_DIR, { recursive: true });

const db = new sqlite3.Database(DB_PATH);
const upload = multer({ dest: UPLOAD_DIR });

const categories = [
  '餐饮', '交通', '购物', '住房', '医疗', '娱乐', '工资', '奖金', '转账', '其他'
];

function run(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.run(sql, params, function (err) {
      if (err) reject(err);
      else resolve({ lastID: this.lastID, changes: this.changes });
    });
  });
}

function get(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.get(sql, params, (err, row) => {
      if (err) reject(err);
      else resolve(row || null);
    });
  });
}

function all(sql, params = []) {
  return new Promise((resolve, reject) => {
    db.all(sql, params, (err, rows) => {
      if (err) reject(err);
      else resolve(rows || []);
    });
  });
}

function makeAesKey() {
  return crypto.createHash('sha256').update(ENCRYPTION_KEY).digest();
}

function encryptValue(value) {
  const iv = crypto.randomBytes(16);
  const cipher = crypto.createCipheriv('aes-256-gcm', makeAesKey(), iv);
  const encrypted = Buffer.concat([
    cipher.update(JSON.stringify(value), 'utf8'),
    cipher.final()
  ]);
  return JSON.stringify({
    iv: iv.toString('hex'),
    data: encrypted.toString('hex'),
    tag: cipher.getAuthTag().toString('hex')
  });
}

function decryptValue(payload) {
  if (!payload) return null;
  const { iv, data, tag } = JSON.parse(payload);
  const decipher = crypto.createDecipheriv('aes-256-gcm', makeAesKey(), Buffer.from(iv, 'hex'));
  decipher.setAuthTag(Buffer.from(tag, 'hex'));
  const decrypted = Buffer.concat([
    decipher.update(Buffer.from(data, 'hex')),
    decipher.final()
  ]);
  return JSON.parse(decrypted.toString('utf8'));
}

function generateToken(user) {
  return jwt.sign({ userId: user.id, email: user.email }, JWT_SECRET, { expiresIn: '7d' });
}

function authMiddleware(req, res, next) {
  const authHeader = req.headers.authorization || '';
  const token = authHeader.startsWith('Bearer ') ? authHeader.slice(7) : null;
  if (!token) {
    return res.status(401).json({ message: '未登录或授权缺失' });
  }

  try {
    const decoded = jwt.verify(token, JWT_SECRET);
    req.user = decoded;
    next();
  } catch (error) {
    return res.status(401).json({ message: 'Token 无效或已过期' });
  }
}

async function initDb() {
  await run(`
    CREATE TABLE IF NOT EXISTS users (
      id TEXT PRIMARY KEY,
      name TEXT NOT NULL,
      email TEXT NOT NULL UNIQUE,
      password_hash TEXT NOT NULL,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
    )
  `);

  await run(`
    CREATE TABLE IF NOT EXISTS bills (
      id TEXT PRIMARY KEY,
      user_id TEXT NOT NULL,
      payload TEXT NOT NULL,
      created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
      FOREIGN KEY(user_id) REFERENCES users(id)
    )
  `);
}

function normalizeAmount(value) {
  const result = Number(value);
  if (!Number.isFinite(result) || result <= 0) {
    throw new Error('金额必须为正数');
  }
  return Number(result.toFixed(2));
}

function detectCategoryFromText(text, type) {
  const source = String(text || '').toLowerCase();
  const rules = [
    ['餐饮', /餐|饭|咖啡|奶茶|外卖|美食|food|restaurant|starbucks|饮品/],
    ['交通', /交通|地铁|公交|打车|出租|加油|停车|滴滴|高铁|火车|机票|taxi|uber/],
    ['购物', /购物|超市|淘宝|京东|拼多多|商场|服饰|商品|mall|amazon/],
    ['住房', /房租|物业|水电|燃气|宽带|住房/],
    ['医疗', /医院|药|医疗|诊所|挂号/],
    ['娱乐', /电影|游戏|旅游|演出|娱乐|会员|视频/],
    ['工资', /工资|薪资|salary|payroll|奖金|收入/],
    ['奖金', /奖金|年终|补贴|红包/],
    ['转账', /转账|转入|转出|汇款|银行卡|收款/],
    ['其他', /./]
  ];

  for (const [category, matcher] of rules) {
    if (matcher.test(source)) {
      return category;
    }
  }

  return type === '收入' ? '工资' : '其他';
}

function normalizeImportedRecord(raw) {
  const rating = raw || {};
  const date = String(rating.date || '').trim();
  const type = String(rating.type || '支出').trim();
  const category = String(rating.category || '').trim() || detectCategoryFromText(rating.note || rating.description || '', type);
  const amount = normalizeAmount(rating.amount || 0);
  const note = String(rating.note || rating.description || '').trim() || '未备注';

  if (!date || !['收入', '支出'].includes(type) || !categories.includes(category)) {
    throw new Error('导入数据缺少必要字段：日期、类型、分类或金额');
  }

  return {
    id: crypto.randomUUID(),
    date,
    type,
    category,
    amount,
    note,
    source: String(rating.source || '文件导入')
  };
}

app.use(cors());
app.use(express.json({ limit: '20mb' }));
app.use(express.urlencoded({ extended: true }));
app.use('/uploads', express.static(UPLOAD_DIR));

app.get('/api/health', (req, res) => {
  res.json({ status: 'ok', time: new Date().toISOString() });
});

app.post('/api/register', async (req, res) => {
  try {
    const { name, email, password } = req.body || {};
    if (!name || !email || !password) {
      return res.status(400).json({ message: '姓名、邮箱、密码为必填项' });
    }
    if (String(password).length < 8) {
      return res.status(400).json({ message: '密码至少 8 位' });
    }

    const exists = await get('SELECT id FROM users WHERE email = ?', [String(email).trim().toLowerCase()]);
    if (exists) {
      return res.status(409).json({ message: '邮箱已被注册' });
    }

    const user = {
      id: crypto.randomUUID(),
      name: String(name).trim(),
      email: String(email).trim().toLowerCase(),
      passwordHash: await bcrypt.hash(String(password), 10)
    };

    await run(
      'INSERT INTO users (id, name, email, password_hash) VALUES (?, ?, ?, ?)',
      [user.id, user.name, user.email, user.passwordHash]
    );

    const token = generateToken(user);
    res.status(201).json({ token, user: { id: user.id, name: user.name, email: user.email } });
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: '注册失败' });
  }
});

app.post('/api/login', async (req, res) => {
  try {
    const { email, password } = req.body || {};
    if (!email || !password) {
      return res.status(400).json({ message: '邮箱和密码不能为空' });
    }

    const user = await get('SELECT * FROM users WHERE email = ?', [String(email).trim().toLowerCase()]);
    if (!user) {
      return res.status(401).json({ message: '邮箱或密码错误' });
    }

    const valid = await bcrypt.compare(String(password), user.password_hash);
    if (!valid) {
      return res.status(401).json({ message: '邮箱或密码错误' });
    }

    const token = generateToken(user);
    res.json({
      token,
      user: { id: user.id, name: user.name, email: user.email }
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: '登录失败' });
  }
});

app.get('/api/me', authMiddleware, async (req, res) => {
  const user = await get('SELECT id, name, email FROM users WHERE id = ?', [req.user.userId]);
  if (!user) {
    return res.status(404).json({ message: '用户不存在' });
  }
  res.json(user);
});

app.get('/api/bills', authMiddleware, async (req, res) => {
  try {
    const rows = await all('SELECT * FROM bills WHERE user_id = ? ORDER BY created_at DESC', [req.user.userId]);
    const bills = rows
      .map((row) => {
        try {
          const bill = decryptValue(row.payload);
          return {
            id: row.id,
            ...bill,
            created_at: row.created_at
          };
        } catch (error) {
          return null;
        }
      })
      .filter(Boolean);

    res.json(bills);
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: '读取账单失败' });
  }
});

app.post('/api/bills', authMiddleware, async (req, res) => {
  try {
    const { date, type, category, amount, note, source = '手动录入' } = req.body || {};
    if (!date || !type || !category || !amount) {
      return res.status(400).json({ message: '日期、类型、分类、金额为必填项' });
    }

    if (!['收入', '支出'].includes(type)) {
      return res.status(400).json({ message: '类型必须为 收入 或 支出' });
    }

    if (!categories.includes(category)) {
      return res.status(400).json({ message: '分类不支持' });
    }

    const bill = {
      id: crypto.randomUUID(),
      date: String(date),
      type: String(type),
      category: String(category),
      amount: normalizeAmount(amount),
      note: String(note || '').trim() || '未备注',
      source: String(source)
    };

    await run(
      'INSERT INTO bills (id, user_id, payload, created_at) VALUES (?, ?, ?, ?)',
      [bill.id, req.user.userId, encryptValue(bill), new Date().toISOString()]
    );

    res.status(201).json({ message: '账单已保存', bill });
  } catch (error) {
    console.error(error);
    res.status(400).json({ message: error.message || '账单保存失败' });
  }
});

app.put('/api/bills/:id', authMiddleware, async (req, res) => {
  try {
    const { id } = req.params;
    const row = await get('SELECT * FROM bills WHERE id = ? AND user_id = ?', [id, req.user.userId]);
    if (!row) {
      return res.status(404).json({ message: '账单不存在' });
    }

    const current = decryptValue(row.payload);
    const updated = {
      ...current,
      ...req.body,
      id: current.id,
      amount: normalizeAmount(req.body.amount || current.amount),
      note: String(req.body.note || current.note || '').trim() || '未备注',
      source: String(req.body.source || current.source || '手动编辑')
    };

    if (!['收入', '支出'].includes(updated.type)) {
      return res.status(400).json({ message: '类型必须为 收入 或 支出' });
    }
    if (!categories.includes(updated.category)) {
      return res.status(400).json({ message: '分类不支持' });
    }

    await run('UPDATE bills SET payload = ? WHERE id = ? AND user_id = ?', [
      encryptValue(updated),
      id,
      req.user.userId
    ]);

    res.json({ message: '账单已更新', bill: updated });
  } catch (error) {
    console.error(error);
    res.status(400).json({ message: error.message || '更新失败' });
  }
});

app.delete('/api/bills/:id', authMiddleware, async (req, res) => {
  try {
    const { id } = req.params;
    const result = await run('DELETE FROM bills WHERE id = ? AND user_id = ?', [id, req.user.userId]);
    if (result.changes === 0) {
      return res.status(404).json({ message: '账单不存在' });
    }
    res.json({ message: '账单已删除' });
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: '删除失败' });
  }
});

app.post('/api/import', authMiddleware, async (req, res) => {
  try {
    const records = Array.isArray(req.body) ? req.body : (req.body?.records || []);
    if (!records.length) {
      return res.status(400).json({ message: '没有可导入的数据' });
    }

    const normalized = records.map((record) => normalizeImportedRecord(record));
    const inserts = normalized.map((bill) =>
      run('INSERT INTO bills (id, user_id, payload, created_at) VALUES (?, ?, ?, ?)', [
        bill.id,
        req.user.userId,
        encryptValue(bill),
        new Date().toISOString()
      ])
    );

    await Promise.all(inserts);
    res.status(201).json({ message: `已导入 ${normalized.length} 笔账单`, count: normalized.length });
  } catch (error) {
    console.error(error);
    res.status(400).json({ message: error.message || '导入失败' });
  }
});

app.get('/api/summary', authMiddleware, async (req, res) => {
  try {
    const month = String(req.query.month || new Date().toISOString().slice(0, 7));
    const rows = await all('SELECT * FROM bills WHERE user_id = ?', [req.user.userId]);
    const bills = rows
      .map((row) => {
        try {
          const bill = decryptValue(row.payload);
          return { ...bill, created_at: row.created_at };
        } catch {
          return null;
        }
      })
      .filter(Boolean);

    const monthly = bills.filter((item) => item.date.startsWith(month));
    const income = monthly.filter((item) => item.type === '收入').reduce((sum, item) => sum + Number(item.amount || 0), 0);
    const expense = monthly.filter((item) => item.type === '支出').reduce((sum, item) => sum + Number(item.amount || 0), 0);
    const balance = income - expense;

    const categoryMap = {};
    for (const item of monthly.filter((entry) => entry.type === '支出')) {
      const key = item.category || '其他';
      categoryMap[key] = (categoryMap[key] || 0) + Number(item.amount || 0);
    }

    const trend = [];
    const start = new Date(`${month}-01T00:00:00`);
    for (let i = 5; i >= 0; i -= 1) {
      const current = new Date(start);
      current.setMonth(current.getMonth() - i);
      const key = `${current.getFullYear()}-${String(current.getMonth() + 1).padStart(2, '0')}`;
      const ledger = bills.filter((entry) => entry.date.startsWith(key));
      const incoming = ledger.filter((entry) => entry.type === '收入').reduce((sum, item) => sum + Number(item.amount || 0), 0);
      const outgoing = ledger.filter((entry) => entry.type === '支出').reduce((sum, item) => sum + Number(item.amount || 0), 0);
      trend.push({
        month: key,
        label: `${current.getMonth() + 1}月`,
        income: incoming,
        expense: outgoing
      });
    }

    res.json({
      month,
      income: Number(income.toFixed(2)),
      expense: Number(expense.toFixed(2)),
      balance: Number(balance.toFixed(2)),
      byCategory: Object.entries(categoryMap)
        .map(([name, value]) => ({ name, value: Number(value.toFixed(2)) }))
        .sort((a, b) => b.value - a.value),
      trend
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: '生成报表失败' });
  }
});

app.post('/api/upload', upload.single('file'), async (req, res) => {
  try {
    if (!req.file) {
      return res.status(400).json({ message: '未上传文件' });
    }

    const filePath = req.file.path;
    const ext = path.extname(req.file.originalname || '').toLowerCase();

    if (!['.csv', '.xlsx', '.xls', '.png', '.jpg', '.jpeg', '.webp'].includes(ext)) {
      return res.status(400).json({ message: '支持 CSV、Excel 和图片文件' });
    }

    res.json({
      message: '文件已接收，前端可以继续解析并导入',
      fileUrl: `/uploads/${path.basename(filePath)}`,
      fileName: req.file.originalname,
      ext
    });
  } catch (error) {
    console.error(error);
    res.status(500).json({ message: '上传失败' });
  }
});

app.use(express.static(path.join(__dirname, 'public')));

app.get('*', (req, res) => {
  if (req.path.startsWith('/api/')) {
    return res.status(404).json({ message: '接口不存在' });
  }
  res.sendFile(path.join(__dirname, 'public', 'index.html'));
});

async function bootstrap() {
  await initDb();
  app.listen(PORT, () => {
    console.log(`Billflow online app is running at http://localhost:${PORT}`);
  });
}

bootstrap();
